# updated envs for deployment
DATABASE_URL=postgresql://user:password@server.postgres.database.azure.com:5432/dbname?sslmode=require

# Azure Custom Vision
AZURE_CUSTOM_VISION_PREDICTION_ENDPOINT=https://your-resource.cognitiveservices.azure.com/customvision/v3.0/Prediction/...
AZURE_CUSTOM_VISION_PREDICTION_KEY=your_custom_vision_key

GEMINI_API=your_gemini_key

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_openai_key
AZURE_OPENAI_DEPLOYMENT=gpt-5-chat
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Gemini
GEMINI_API=your_gemini_key_here

# JWT
SECRET_KEY=generate_a_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Free-tier stack (replaces Azure) ---
# Neon Postgres (free): copy the connection string from the Neon dashboard. Needs: pip install psycopg2-binary
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Cloudinary (free): Dashboard > API Keys. Used for profile/food images when all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Leave AZURE_* empty/removed: the app falls back to mock analysis and local storage.

# HUAWEI Health direct connection (see docs/HUAWEI_HEALTH_SETUP.md)
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=
HUAWEI_REDIRECT_URI=https://your-public-url/huawei/callback

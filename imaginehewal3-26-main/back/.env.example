# updated envs for deployment
DATABASE_URL=postgresql://user:password@server.postgres.database.azure.com:5432/dbname?sslmode=require

# Azure Custom Vision
AZURE_CUSTOM_VISION_PREDICTION_ENDPOINT=https://your-resource.cognitiveservices.azure.com/customvision/v3.0/Prediction/...
AZURE_CUSTOM_VISION_PREDICTION_KEY=your_custom_vision_key

GEMINI_API=your_gemini_key

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_openai_key
AZURE_OPENAI_DEPLOYMENT=gpt-5-chat
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Gemini
GEMINI_API=your_gemini_key_here

# JWT
SECRET_KEY=generate_a_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# --- Free-tier stack (replaces Azure) ---
# Neon Postgres (free): copy the connection string from the Neon dashboard. Needs: pip install psycopg2-binary
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Cloudinary (free): Dashboard > API Keys. Used for profile/food images when all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Leave AZURE_* empty/removed: the app falls back to mock analysis and local storage.

# HUAWEI Health direct connection (see docs/HUAWEI_HEALTH_SETUP.md)
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=
HUAWEI_REDIRECT_URI=https://your-public-url/huawei/callback

# ---- Email (real emails: verification, password reset, sign-in codes, "password changed" notices)
# SendGrid: https://app.sendgrid.com > Settings > API Keys (permission: Mail Send). FROM_EMAIL MUST be verified there:
# Settings > Sender Authentication > Single Sender Verification (testing) or domain authentication (real use, avoids spam folders).
# Check everything with:  python scripts/send_test_email.py you@example.com
SENDGRID_API_KEY=
FROM_EMAIL=
EMAIL_FROM_NAME=HEWAL3
HEWAL3_SUPPORT_EMAIL=support@hewal3.com
# The PUBLIC https address of THIS backend. Links in emails are built from it. localhost will not open on a phone.
BASE_URL=https://your-backend.example.com
# Optional fallback used when SendGrid cannot send (out of credits, rejected key). Gmail: smtp.gmail.com, 587, your address, an APP PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_FROM=   (defaults to FROM_EMAIL; Gmail only sends as the signed-in account)
# EMAIL_SANDBOX=1   asks SendGrid to validate without delivering.   EMAIL_ENABLED=0   switches email off.
